{% extends "base.html" %}
{% block content %}
<div class="roadmap-page">
    <aside class="panel-left">
        <div class="panel-header">Phase 1 & 2</div>
        <div id="tree-left"></div>
    </aside>
    <main class="panel-center">
        <div class="graph-wrapper">
            <div class="search-container"><input type="text" id="search-input" placeholder="Search nodes..."></div>
            <button class="btn-center" onclick="window.doCenter()">Center View</button>
            <div id="graph-loading">Loading 3D...</div>
            <div id="3d-graph"></div>
            <div class="watermark">NeuroVault Architecture</div>
        </div>
    </main>
    <aside class="panel-right">
        <div class="panel-header">Phase 3 & 4</div>
        <div id="tree-right" style="margin-bottom: 2rem;"></div>
        
        <div class="detail-panel" id="detail-panel">
            <span class="panel-category">SECOND BRAIN NODE</span>
            <h3 class="panel-title" id="panel-title">Select a node</h3>
            <div class="panel-desc" id="panel-desc">Click on a node to view description.</div>
            <div class="panel-links" id="panel-links"></div>
            
            <!-- Khung Ghi chÃº cÃ¡ nhÃ¢n -->
            <div class="note-editor" id="note-editor" style="display: none; margin-top: 1.5rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
                <label style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">PERSONAL NOTES:</label>
                <textarea id="node-note" placeholder="Write your thoughts, links, or code snippets here..." style="width: 100%; height: 100px; margin-top: 0.5rem; background: var(--bg-base); border: 1px solid var(--border-color); color: var(--text-primary); padding: 10px; border-radius: 6px; font-family: var(--font-mono); font-size: 0.85rem; resize: vertical;"></textarea>
                <button id="save-note-btn" style="margin-top: 0.5rem; width: 100%; padding: 8px; background: var(--text-primary); color: var(--bg-base); border: none; border-radius: 4px; cursor: pointer; font-family: var(--font-mono);">Save Note</button>
            </div>
        </div>
    </aside>
</div>
{% endblock %}
<!-- COGNICRAFT_GRAPH_FIX_FINAL -->
<script>
window.addEventListener('load', function() {
    let attempts = 0;
    const interval = setInterval(() => {
        // Tìm biến chứa đồ thị
        let g = (typeof Graph !== 'undefined') ? Graph : 
                ((typeof myGraph !== 'undefined') ? myGraph : 
                ((typeof graph !== 'undefined') ? graph : 
                ((typeof my3dGraph !== 'undefined') ? my3dGraph : null)));

        // Kiểm tra xem đồ thị đã có dữ liệu chưa
        if (g && typeof g.graphData === 'function' && g.graphData().nodes.length > 0) {
            clearInterval(interval);
            
            // 1. Phóng to node
            g.nodeRelSize(10); 
            g.nodeResolution(16);
            
            // 2. Trực tiếp gán màu vào từng Node trong Data
            g.graphData().nodes.forEach(n => {
                let text = ((n.id || '') + ' ' + (n.name || '')).toLowerCase();
                
                // Toán (Xanh dương)
                if (text.includes('math') || text.includes('calculus') || text.includes('algebra') || text.includes('probability') || text.includes('logic') || text.includes('discrete') || text.includes('statistics')) {
                    n.color = '#3b82f6'; 
                }
                // Python (Vàng)
                else if (text.includes('python') || text.includes('oop') || text.includes('dsa') || text.includes('pandas') || text.includes('numpy') || text.includes('programming')) {
                    n.color = '#eab308'; 
                }
                // SQL (Đỏ)
                else if (text.includes('sql') || text.includes('query') || text.includes('joins') || text.includes('database')) {
                    n.color = '#ef4444'; 
                }
                // Data Science (Xanh lá)
                else if (text.includes('data') || text.includes('machine') || text.includes('mlops') || text.includes('eda') || text.includes('learning') || text.includes('deep')) {
                    n.color = '#10a37f'; 
                }
                else {
                    n.color = '#888888'; // Xám cho các node phụ
                }
            });

            // 3. Ép đồ thị vẽ lại màu mới
            g.nodeColor(n => n.color);
            g.linkColor(() => 'rgba(255,255,255,0.15)');
            g.linkWidth(1.2);

            // 4. Căn giữa lại lần nữa
            setTimeout(() => g.zoomToFit(1000, 80), 300);
        }
        
        attempts++;
        if (attempts > 40) clearInterval(interval); // Đợi tối đa 20 giây
    }, 500);
});
</script>